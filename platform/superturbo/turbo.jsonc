{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//", "@patricktree/config-turbo"],
  "tasks": {
    "turbo:build": {
      "cache": true,
      "outputs": ["*.tsbuildinfo"],
    },
    "turbo:lint": {
      "cache": true,
      "outputs": [],
    },
    "turbo:lint:fix": {
      "cache": true,
      "outputs": ["src/**", "test/**"],
    },
  },
}
