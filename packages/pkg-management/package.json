{
  "name": "@patricktree/pkg-management",
  "version": "2.1.5",
  "homepage": "https://github.com/patricktree/packages/tree/main/packages/pkg-management",
  "bugs": {
    "url": "https://github.com/patricktree/packages/issues"
  },
  "license": "MIT",
  "author": "Patrick Kerschbaum <patrick.kerschbaum@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/patricktree/packages",
    "directory": "packages/pkg-management"
  },
  "bin": {
    "add-all-tsconfigs-as-project-references": "./dist/add-all-tsconfigs-as-project-references.mjs",
    "create-pnpm-patch-via-ts-patch": "./dist/create-pnpm-patch-via-ts-patch.mjs"
  },
  "files": [
    "dist/**",
    "!dist/**/*.d.ts.map"
  ],
  "type": "module",
  "imports": {
    "#pkg/*": "./src/*"
  },
  "exports": {
    ".": null,
    "./*": null
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "build:watch": "turbo watch turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "internal:compile": "tsc --build ./tsconfig.json",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "turbo:build": "pnpm run internal:compile && babel src --out-dir dist --keep-file-extension",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^12.1.0",
    "@patricktree/commons-ecma": "workspace:^",
    "@patricktree/commons-node": "workspace:^",
    "@pnpm/find-workspace-packages": "^6.0.9",
    "@pnpm/logger": "^5.2.0",
    "commander": "^12.1.0",
    "tempy": "^3.1.0",
    "zx": "^8.1.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.6",
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-explicit-resource-management": "^7.24.7",
    "@patricktree-stack/config-oxlint": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
