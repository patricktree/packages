{
  "name": "@patricktree/typescript-eslint-rules-requiring-type-info",
  "version": "1.0.3",
  "keywords": [
    "typescript-eslint"
  ],
  "homepage": "https://github.com/patricktree/packages/tree/main/packages/typescript-eslint-rules-requiring-type-info",
  "bugs": {
    "url": "https://github.com/patricktree/typescript-eslint-rules-requiring-type-info/issues"
  },
  "license": "MIT",
  "author": "Patrick Kerschbaum <patrick.kerschbaum@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/patricktree/packages",
    "directory": "packages/typescript-eslint-rules-requiring-type-info"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#pkg/*": "./dist/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "build:watch": "turbo watch turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "internal:compile": "tsc --build ./tsconfig.json",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "prepack": "pnpm run clean && pnpm run build",
    "test": "turbo run turbo:test",
    "test:pkg-consumption": "pkg-consumption-test --packageName=\"@patricktree/typescript-eslint-rules-requiring-type-info\" --pathToScenariosDirectory=\"./test-pkg-consumption-scenarios\"",
    "turbo:build": "pnpm run internal:compile",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix",
    "turbo:test": "pnpm run test:pkg-consumption"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "jsdom": "^25.0.0"
  },
  "devDependencies": {
    "@patricktree-stack/config-oxlint": "workspace:*",
    "@patricktree/pkg-consumption-test": "workspace:*",
    "@types/eslint": "^8.56.12",
    "@types/jsdom": "^21.1.7",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
