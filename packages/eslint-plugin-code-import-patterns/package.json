{
  "name": "eslint-plugin-code-import-patterns",
  "version": "3.0.3",
  "private": false,
  "keywords": [
    "code-import-patterns",
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "import",
    "modules"
  ],
  "homepage": "https://github.com/patricktree/packages/tree/main/packages/eslint-plugin-code-import-patterns",
  "bugs": {
    "url": "https://github.com/patricktree/packages/issues"
  },
  "license": "MIT",
  "author": "Patrick Kerschbaum <patrick.kerschbaum@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/patricktree/packages",
    "directory": "packages/eslint-plugin-code-import-patterns"
  },
  "files": [
    "dist/**",
    "!dist/**/*.d.ts.map"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "imports": {
    "#pkg/*": "./dist/*"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "build:watch": "turbo watch turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "internal:compile": "tsc --build ./tsconfig.json",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "turbo:build": "pnpm run internal:compile",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix"
  },
  "dependencies": {
    "@typescript-eslint/experimental-utils": "^5.62.0"
  },
  "devDependencies": {
    "@patricktree-stack/config-oxlint": "workspace:*",
    "@types/eslint": "^8.56.12",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "^8.57.1",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
