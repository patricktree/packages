{
  "name": "eslint-plugin-code-import-patterns",
  "version": "3.0.3",
  "private": false,
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "import",
    "code-import-patterns",
    "modules"
  ],
  "homepage": "https://github.com/patricktree/packages/tree/main/packages/eslint-plugin-code-import-patterns",
  "bugs": {
    "url": "https://github.com/patricktree/packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/patricktree/packages",
    "directory": "packages/eslint-plugin-code-import-patterns"
  },
  "license": "MIT",
  "author": "Patrick Kerschbaum <patrick.kerschbaum@gmail.com>",
  "imports": {
    "#pkg/*": "./dist/*"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "files": [
    "dist/**",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "superturbo run turbo:build",
    "dev": "pnpm run build --watch --preserveWatchOutput",
    "internal:compile": "tsc --build ./tsconfig.json",
    "lint": "superturbo run turbo:lint",
    "lint:file": "eslint --max-warnings 0",
    "lint:fix": "superturbo run turbo:lint:fix",
    "nuke": "pnpm run nuke:artifacts && del-cli node_modules",
    "nuke:artifacts": "del-cli dist \"*.tsbuildinfo\"",
    "turbo:build": "pnpm run internal:compile",
    "turbo:lint": "pnpm run lint:file .",
    "turbo:lint:fix": "pnpm run lint --fix"
  },
  "dependencies": {
    "@typescript-eslint/experimental-utils": "^5.62.0"
  },
  "devDependencies": {
    "@types/eslint": "^8.56.12",
    "@types/node": "^20",
    "eslint": "^8.57.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
