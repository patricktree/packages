{
  "name": "@patricktree/codemod-rewrite-module-specifiers-to-full-paths",
  "version": "2.3.0",
  "homepage": "https://github.com/patricktree/packages/tree/main/packages/codemod-rewrite-module-specifiers-to-full-paths",
  "bugs": {
    "url": "https://github.com/patricktree/packages/issues"
  },
  "license": "MIT",
  "author": "Patrick Kerschbaum <patrick.kerschbaum@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/patricktree/packages",
    "directory": "packages/codemod-rewrite-module-specifiers-to-full-paths"
  },
  "bin": "./dist/bin/codemod.js",
  "files": [
    "dist/**",
    "!dist/**/*.d.ts.map"
  ],
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "imports": {
    "#pkg/*": "./dist/*",
    "#pkg-test/*": "./test/*"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "build:watch": "turbo watch turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "internal:compile": "tsc --build ./tsconfig.json",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "test": "turbo run turbo:test",
    "turbo:build": "pnpm run internal:compile",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix",
    "turbo:test": "vitest run --config=\"./test/vitest.config.mts\""
  },
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.208.0",
    "@opentelemetry/sdk-logs": "^0.208.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@patricktree/commons-node": "workspace:*",
    "commander": "^14.0.2",
    "jscodeshift": "^17.3.0",
    "p-limit": "^7.2.0",
    "tiny-invariant": "^1.3.3",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@patricktree-stack/config-oxlint": "workspace:*",
    "@patricktree/runtime-extensions-node": "workspace:*",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "ts-expose-internals": "^5.6.3",
    "vitest": "catalog:"
  }
}
