{
  "name": "@patricktree/codemod-rewrite-module-specifiers-to-full-paths",
  "version": "2.0.0",
  "homepage": "https://github.com/patricktree/packages/tree/main/packages/codemod-rewrite-module-specifiers-to-full-paths",
  "bugs": {
    "url": "https://github.com/patricktree/packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/patricktree/packages",
    "directory": "packages/codemod-rewrite-module-specifiers-to-full-paths"
  },
  "license": "MIT",
  "author": "Patrick Kerschbaum <patrick.kerschbaum@gmail.com>",
  "type": "module",
  "imports": {
    "#pkg/*": "./dist/*",
    "#pkg-test/*": "./test/*"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "bin": "./dist/bin/codemod.js",
  "files": [
    "dist/**",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "superturbo run turbo:build",
    "dev": "pnpm run build --watch --preserveWatchOutput",
    "internal:compile": "tsc --build ./tsconfig.json",
    "lint": "superturbo run turbo:lint",
    "lint:file": "eslint --max-warnings 0",
    "lint:fix": "superturbo run turbo:lint:fix",
    "nuke": "pnpm run nuke:artifacts && del-cli node_modules",
    "nuke:artifacts": "del-cli dist \"*.tsbuildinfo\"",
    "test": "vitest run --config=\"./test/vitest.config.mts\"",
    "turbo:build": "pnpm run internal:compile",
    "turbo:lint": "pnpm run lint:file .",
    "turbo:lint:fix": "pnpm run lint --fix"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^12.1.0",
    "@patricktree/commons-ecma": "workspace:*",
    "@patricktree/commons-node": "workspace:*",
    "commander": "^12.1.0",
    "jscodeshift": "^17.0.0",
    "p-limit": "^6.1.0",
    "tiny-invariant": "^1.3.3",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@patricktree/runtime-extensions-node": "workspace:*",
    "@types/jscodeshift": "^0.11.11",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^2.0.5",
    "ts-expose-internals": "^5.5.4",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
