{
  "name": "@patricktree/pkg-consumption-test",
  "version": "1.0.7",
  "homepage": "https://github.com/patricktree/packages/tree/main/packages/pkg-consumption-test",
  "bugs": {
    "url": "https://github.com/patricktree/packages/issues"
  },
  "license": "MIT",
  "author": "Patrick Kerschbaum <patrick.kerschbaum@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/patricktree/packages",
    "directory": "packages/pkg-consumption-test"
  },
  "bin": {
    "pkg-consumption-test": "./pkg-consumption-test.js"
  },
  "files": [
    "/dist",
    "/src",
    "/pkg-consumption-test.js",
    "/README.md"
  ],
  "type": "module",
  "imports": {
    "#pkg/*": "./dist/*"
  },
  "exports": {
    ".": "./dist/start-test.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "build:watch": "turbo watch turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "internal:compile": "tsc --build ./tsconfig.json",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "prepublishOnly": "pnpm run build",
    "turbo:build": "pnpm run internal:compile",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^12.1.0",
    "@patricktree/commons-ecma": "workspace:^",
    "@patricktree/commons-node": "workspace:^",
    "commander": "^12.1.0",
    "pathe": "^1.1.2",
    "verdaccio": "^5.32.1",
    "zx": "^8.1.5"
  },
  "devDependencies": {
    "@patricktree-stack/config-oxlint": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@verdaccio/types": "10.8.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
