{
  "extends": "@patricktree/config-typescript/tsconfig.json",
  "compilerOptions": {
    /* Modules */
    "rootDir": "./src",
    "types": ["node"],

    /* Emit */
    "outDir": "./dist",

    /* Interop Constraints */
    /* disable "verbatimModuleSyntax" because it is annoying for CJS packages */
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*"]
}
